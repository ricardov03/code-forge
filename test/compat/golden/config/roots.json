    "name": "root/home-no-config",
    "files": {},
    "cwd": "home/sub",
    "group": "root",
    "home": "home",
    "expected": {
      "ok": false,
      "path": "$ROOT/home/sub/.code-forge.yml",
      "error": "not-found",
      "message": "no config file at $ROOT/home/sub/.code-forge.yml"
    },
    "root": "$ROOT/home/sub"
  },
  {
    "name": "root/outside-home",
    "files": {
      ".code-forge.yml": "name: outside"
    },
    "cwd": "project/sub",
    "group": "root",
