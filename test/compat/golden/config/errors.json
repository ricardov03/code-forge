[
  {
    "name": "migrate/future",
    "files": {
      "project/.code-forge.yml": "{\"version\":2}"
    },
    "group": "error",
    "home": "home",
    "cwd": "project",
    "expected": {
      "ok": false,
      "path": "$ROOT/project/.code-forge.yml",
      "error": "migrate-error",
      "message": "migrateConfig: config version 2 is newer than this code-forge understands (1) — upgrade the package"
    }
  },
