{
  "name": "@codedology/code-forge",
  "version": "0.12.0",
  "description": "Plan/harden/code/review orchestration CLI and Agent Skill for cross-model, parallel, evidence-gated feature delivery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardov03/code-forge.git"
  },
  "homepage": "https://github.com/ricardov03/code-forge#readme",
  "bugs": {
    "url": "https://github.com/ricardov03/code-forge/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-forge": "bin/code-forge.mjs"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "skill",
    "docs/reference",
    "examples",
    "scripts",
    "!scripts/release.mjs",
    "!scripts/changelog.mjs",
    "!scripts/known-fix.mjs",
    "!scripts/bench-review.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "sh test/helpers/run-suite.sh",
    "typecheck": "tsc --checkJs --noEmit",
    "release": "node scripts/release.mjs",
    "changelog": "node scripts/changelog.mjs",
    "known-fix": "node scripts/known-fix.mjs",
    "bench:review": "node scripts/bench-review.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
