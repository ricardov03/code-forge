project:
.code-forge.yml -rw-r--r--
version: 1
project:
  name: myproj
  slug: myproj
provider: anthropic
levels:
  L0:
    model: claude-haiku-4-5-20251001
  L1:
    model: claude-sonnet-5
  L2:
    model: claude-opus-5-5
  L3:
    model: claude-fable-5-2
caps:
  coders: 1
review:
  multimodel: false
engine: auto
harnesses: []
keys:
  jev: user
gates:
  test: null
  lint: null
  types: null
  format: null
  ram_tmp: off
  ram_tmp_mb: 2048
  coder_test_parallel: 2
proof:
  tiers:
    high:
      paths: []
  isolation: export
  export:
    link_dirs: []
    copy_untracked: []
autonomy:
  coder_may_push: false
  coder_may_open_draft_pr: false
land:
  require_main_ci: false
autopilot:
  step_budgets:
    margin: 0.5
    min_samples: 5
release:
  max_blocks: 8

home:
.code-forge drwxr-xr-x
.code-forge/config.yml -rw-r--r--
tools: current
keys:
  jev:
    source: file

.code-forge/store drwxr-xr-x
.code-forge/store/jev.key -rw-------
sk-b548-plain
