project:
.code-forge.yml -rw-r--r--
version: 1
project:
  name: shop
  slug: shop
provider: anthropic
levels:
  L0:
    model: claude-haiku-4-5-20251001
  L1:
    model: claude-sonnet-5
  L2:
    model: claude-opus-5-5
  L3:
    model: claude-fable-5-2
caps:
  coders: 1
review:
  multimodel: false
engine: auto
harnesses: []
system1:
  fallback: rules
gates:
  test: null
  lint: null
  types: null
  format: null
  ram_tmp: auto
proof:
  tiers:
    high:
      paths: []
  isolation: export
  export:
    link_dirs:
      - vendor
    copy_untracked:
      - .env
      - .env.testing
autonomy:
  coder_may_push: false
  coder_may_open_draft_pr: false

.env -rw-r--r--

.env.testing -rw-r--r--

artisan -rw-r--r--

composer.json -rw-r--r--
{"name":"acme/shop"}
home:
.code-forge drwx------
.code-forge/config.yml -rw-r--r--
tools: current
keys:
  jev:
    source: none
