project:
.code-forge.yml -rw-r--r--
version: 1
project:
  name: Web App
  slug: web-app
provider: anthropic
levels:
  L0:
    model: claude-haiku-4-5-20251001
  L1:
    model: claude-sonnet-5
  L2:
    model: claude-opus-5-5
  L3:
    model: claude-fable-5-2
caps:
  coders: 1
review:
  multimodel: false
engine: auto
harnesses: []
system1:
  fallback: rules
gates:
  test:
    - npm
    - test
  lint:
    - npm
    - run
    - lint
  types:
    - npx
    - tsc
    - --noEmit
  format: null
  ram_tmp: auto
  ram_tmp_mb: 2048
proof:
  tiers:
    high:
      paths: []
  isolation: export
  export:
    link_dirs:
      - node_modules
    copy_untracked:
      - .env
autonomy:
  coder_may_push: false
  coder_may_open_draft_pr: false

.env -rw-r--r--
A=1

.git drwxr-xr-x
.git/HEAD -rw-r--r--
ref: refs/heads/main

package.json -rw-r--r--
{"name":"@acme/Web App","scripts":{"test":"vitest","lint":"eslint ."}}
tsconfig.json -rw-r--r--
{}
home:
.code-forge drwx------
.code-forge/config.yml -rw-r--r--
tools: current
keys:
  jev:
    source: none
