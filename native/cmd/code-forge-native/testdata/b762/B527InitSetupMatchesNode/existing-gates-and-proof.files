project:
.code-forge.yml -rw-r--r--
version: 1
gates:
  test:
    - npm
    - test
  lint:
    argv:
      - npx
      - eslint
      - src dir
    env:
      Z: "1"
      A: "2"
  types: null
  format: null
  ram_tmp: auto
proof:
  isolation: lock
  tiers:
    high:
      paths:
        - src/auth
  export:
    link_dirs:
      - node_modules
    copy_untracked: []
project:
  name: app
  slug: app
provider: anthropic
levels:
  L0:
    model: claude-haiku-4-5-20251001
  L1:
    model: claude-sonnet-5
  L2:
    model: claude-opus-5-5
  L3:
    model: claude-fable-5-2
caps:
  coders: 1
review:
  multimodel: false
engine: auto
harnesses: []
system1:
  fallback: rules
autonomy:
  coder_may_push: false
  coder_may_open_draft_pr: false

package.json -rw-r--r--
{"name":"app"}
home:
.code-forge drwx------
.code-forge/config.yml -rw-r--r--
tools: current
keys:
  jev:
    source: none
