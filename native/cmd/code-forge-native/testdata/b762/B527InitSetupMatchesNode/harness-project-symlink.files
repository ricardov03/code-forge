project:
.agents drwxr-xr-x
.agents/skills drwxr-xr-x
.agents/skills/code-forge L -> <PKG>/skill
.claude drwxr-xr-x
.claude/skills drwxr-xr-x
.claude/skills/code-forge L -> <PKG>/skill
.code-forge.yml -rw-r--r--
version: 1
project:
  name: myproj
  slug: myproj
provider: anthropic
levels:
  L0:
    model: claude-haiku-4-5-20251001
  L1:
    model: claude-sonnet-5
  L2:
    model: claude-opus-5-5
  L3:
    model: claude-fable-5-2
caps:
  coders: 1
review:
  multimodel: false
engine: auto
harnesses:
  - claude
  - codex
system1:
  fallback: rules
gates:
  test: null
  lint: null
  types: null
  format: null
  ram_tmp: off
  ram_tmp_mb: 2048
  coder_test_parallel: 2
proof:
  tiers:
    high:
      paths: []
  isolation: export
  export:
    link_dirs: []
    copy_untracked: []
autonomy:
  coder_may_push: false
  coder_may_open_draft_pr: false
land:
  require_main_ci: false
  regenerate: []
autopilot:
  step_budgets:
    margin: 0.5
    min_samples: 5
release:
  max_blocks: 8
human_check:
  autopilot:
    enabled: false
    require_proof: true
    proof_dirs: []
    exclude_waits_for: []
    require_separate_prover: true
rebase:
  approved_binary_sources: []

.git drwxr-xr-x
.git/HEAD -rw-r--r--
x

home:
.code-forge drwx------
.code-forge/config.yml -rw-r--r--
tools: current
keys:
  jev:
    source: none

.code-forge/installs.json -rw-r--r--
{
  "version": 1,
  "installs": [
    {
      "harness": "claude",
      "scope": "project",
      "method": "symlink",
      "source": "<PKG>/skill",
      "target": "<CWD>/.claude/skills/code-forge",
      "linked_at": "<ISO>",
      "version": "<VERSION>"
    },
    {
      "harness": "codex",
      "scope": "project",
      "method": "symlink",
      "source": "<PKG>/skill",
      "target": "<CWD>/.agents/skills/code-forge",
      "linked_at": "<ISO>",
      "version": "<VERSION>"
    }
  ]
}
