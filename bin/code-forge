#!/bin/sh

# npm links this file into a bin directory, sometimes through multiple links.
entry=$0
case "$entry" in
  */*) ;;
  *) entry=$(command -v "$entry") || exit 1 ;;
esac
case "$entry" in
  /*) ;;
  *) entry=$PWD/$entry ;;
esac
while [ -L "$entry" ]; do
  entry_dir=$(CDPATH= cd -P "${entry%/*}" && pwd) || exit 1
  entry=$(readlink "$entry") || exit 1
  case "$entry" in
    /*) ;;
    *) entry=$entry_dir/$entry ;;
  esac
done
pkg=$(CDPATH= cd -P "${entry%/*}/.." && pwd) || exit 1

# CODE_FORGE_NATIVE=0 is the explicit maintainer and test switch: it runs the Node router.
if [ "${CODE_FORGE_NATIVE:-}" = 0 ]; then
  exec node "$pkg/bin/code-forge.mjs" "$@"
fi

# P4-0 (B569): the Go binary is required. Keep this mapping the same as scripts/install.sh.
sys=$(uname -s)
mach=$(uname -m)
case "$sys" in
  Darwin) platform=darwin ;;
  Linux) platform=linux ;;
  *) platform=$(printf '%s' "$sys" | tr '[:upper:]' '[:lower:]') ;;
esac
case "$mach" in
  x86_64|amd64) arch=x64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch=$mach ;;
esac
target=$platform-$arch
# B606: each target's binary is its own npm package, @codedology/code-forge-<target>, an optional
# dependency. Lookup order: (1) under this package (nested node_modules), (2) beside it (a hoisted or
# global install), (3) the dev build native/bin/<target>. A git checkout (native/go.mod) uses its own
# build only. Keep this lookup the same as scripts/install.sh and the Go pkgroot package.
nested=$pkg/node_modules/@codedology/code-forge-$target/bin/code-forge-native
sibling=${pkg%/*}/code-forge-$target/bin/code-forge-native
dev=$pkg/native/bin/$target/code-forge-native
if [ -f "$pkg/native/go.mod" ]; then
  native=$dev
elif [ -f "$nested" ]; then
  native=$nested
elif [ -f "$sibling" ]; then
  native=$sibling
elif [ -f "$dev" ]; then
  native=$dev
else
  native=$nested
fi

# No usable Go binary: one message on stderr that names the target, the expected path and the
# fix, then exit 69 (no verb exits 69; it means "the Go engine is not available here").
no_engine() {
  printf 'code-forge: %s\n  expected: %s\n  fix: sh '\''%s/scripts/install.sh'\''\n  if that fails, reinstall: npm i -g @codedology/code-forge\n' \
    "$1" "$native" "$pkg" >&2
  exit 69
}
case "$target" in
  darwin-arm64|darwin-x64|linux-arm64|linux-x64) ;;
  *) no_engine "no Go engine is built for $target (built: darwin-arm64, darwin-x64, linux-arm64, linux-x64)" ;;
esac
if [ ! -f "$native" ]; then
  no_engine "the Go engine for $target is missing"
fi
if [ ! -x "$native" ]; then
  no_engine "the Go engine for $target is not executable"
fi

# `code-forge setup` (B463): the Go binary serves it and exits 0 (OK), 1 (problem) or 2 (usage).
# Any other exit means the binary did not run (a crash), so the launcher names the fix itself.
if [ "${1:-}" = setup ]; then
  "$native" "$@"
  status=$?
  case $status in
    0|1|2) exit $status ;;
  esac
  no_engine "the Go engine for $target failed to run setup (exit $status)"
fi
exec "$native" "$@"
