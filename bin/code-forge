#!/bin/sh

# npm links this file into a bin directory, sometimes through multiple links.
entry=$0
case "$entry" in
  */*) ;;
  *) entry=$(command -v "$entry") || exit 1 ;;
esac
case "$entry" in
  /*) ;;
  *) entry=$PWD/$entry ;;
esac
while [ -L "$entry" ]; do
  entry_dir=$(CDPATH= cd -P "${entry%/*}" && pwd) || exit 1
  entry=$(readlink "$entry") || exit 1
  case "$entry" in
    /*) ;;
    *) entry=$entry_dir/$entry ;;
  esac
done
pkg=$(CDPATH= cd -P "${entry%/*}/.." && pwd) || exit 1

host=$(uname -sm)
case "$host" in
  Darwin\ *) platform=darwin ;;
  Linux\ *) platform=linux ;;
  *) platform=unsupported ;;
esac
case "$host" in
  *\ x86_64|*\ amd64) arch=x64 ;;
  *\ arm64|*\ aarch64) arch=arm64 ;;
  *) arch=unsupported ;;
esac
native=$pkg/native/bin/$platform-$arch/code-forge-native
# `code-forge setup` (B463): the Go binary serves it. Its own exits are 0 (OK), 1 (problem) and
# 2 (usage). When the binary is missing, not executable, disabled or exits any other way (a crash),
# Node's scripts/setup.mjs checks it and names the fix.
if [ "${1:-}" = setup ]; then
  if [ "${CODE_FORGE_NATIVE:-}" != 0 ] && [ -f "$native" ] && [ -x "$native" ]; then
    "$native" "$@"
    status=$?
    case $status in
      0|1|2) exit $status ;;
    esac
  fi
  shift
  exec node "$pkg/scripts/setup.mjs" "$@"
fi
if [ "${CODE_FORGE_NATIVE:-}" != 0 ] && [ -f "$native" ] && [ -x "$native" ]; then
  exec "$native" "$@"
fi
exec node "$pkg/bin/code-forge.mjs" "$@"
